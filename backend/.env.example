# Server Configuration
PORT=8000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration
# Use DIRECT_DATABASE_URL for direct PostgreSQL connection
DIRECT_DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Use DATABASE_URL for Prisma Accelerate
DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=your_api_key_here

# JWT Configuration
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here_min_32_chars
ACCESS_TOKEN_EXPIRY=1h

REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# Email Configuration (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
